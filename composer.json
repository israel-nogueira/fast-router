{
    "name": "israel-nogueira/fast-router",
    "description": "Modern, fast and flexible PHP router with support for static and instance modes, middleware chains, and advanced routing features",
    "type": "library",
    "keywords": [
        "router",
        "routing",
        "middleware",
        "php",
        "fast-router",
        "http",
        "url-routing"
    ],
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Israel Nogueira",
            "email": "israel@feats.com",
            "homepage": "https://github.com/israel-nogueira"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "IsraelNogueira\\FastRouter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IsraelNogueira\\FastRouter\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src --level=8"
    }
}
